# Copy to .env.local (git-ignored) and fill in. playwright.config.ts loads it;
# variables already set in the shell win.

# OBS: Tools > WebSocket Server Settings. Turn the server on and copy its password here.
OBS_WS_URL=ws://127.0.0.1:4455
OBS_WS_PASSWORD=

# This PC's LAN address. It must equal PRIVATE_NETWORK_IP in the compose root's .env,
# which Dialog and the local LiveKit server announce to clients; the harness stops if
# the PC's address has changed.
PRIVATE_NETWORK_IP=192.168.0.10

# LiveKit Cloud block (plan 1.4): the WEBRTC tab's URL, key and secret of the Cloud project.
# "npx tsx trials/d-livekit.ts read" fills these from reticulum before switching to the local server;
# "... cloud" writes them back. Leave empty when there is no Cloud project.
LIVEKIT_CLOUD_URL=
LIVEKIT_CLOUD_KEY=
LIVEKIT_CLOUD_SECRET=

# Where runs write their evidence (evidence/<run-id>/) and where the signed-in browser profiles live.
# Absolute, or relative to e2e/; e2e/evidence and e2e/profiles when empty. Both grow to several GB,
# so put them on a drive with room (a run's report.html links its files relatively, so a run folder
# can be moved as a whole). Move the existing folders when changing these.
EVIDENCE_DIR=
PROFILES_DIR=
