#!/bin/bash
basedir=$(dirname "$0")/..

prefix='\n\033[1;37m'
suffix='\033[0m\n'
echo -e ${prefix}Starting mutagen daemon...$suffix
mutagen daemon start
echo -e ${prefix}The mutagen daemon will stay running until you stop it manually with \`mutagen daemon stop\`.$suffix

echo -e ${prefix}Running mutagen-compose...$suffix

# Source .env if it exists (for PRIVATE_NETWORK_IP override, etc.)
if [ -f "$basedir/.env" ]; then
    set -a; source "$basedir/.env"; set +a
fi

if [ -z "$PRIVATE_NETWORK_IP" ]; then
    if [[ "$OSTYPE" == "darwin"* ]]; then
        IP_ADDR=$(ifconfig -l | xargs -n1 ipconfig getifaddr)
    elif [[ "$OSTYPE" == "linux-gnu"* ]]; then
        IP_ADDR=$(ip route get 1 | awk '{print $NF;exit}')
    fi
    PRIVATE_NETWORK_IP=${IP_ADDR}
fi

PRIVATE_NETWORK_IP=${PRIVATE_NETWORK_IP} mutagen-compose -f "$basedir"/docker-compose.yml up --build --detach
