# Local k8s environment values (for Linux k8s testing, NOT Docker Desktop on macOS)
# For local development, use docker-compose instead.

export Container_Dockerhub_Username="mozillareality"
export Container_Tag="stable-latest"

export HUB_DOMAIN="hubs.local"
export Namespace="hcce"

export DB_USER="postgres"
export DB_NAME="retdb"
export DB_HOST="pgbouncer"
export DB_HOST_T="pgbouncer-t"

# Set to your machine's LAN IP (e.g., 192.168.11.2)
# Used for MEDIASOUP_ANNOUNCED_IP and coturn EXTERNAL_IP
export ANNOUNCED_IP="192.168.11.2"
