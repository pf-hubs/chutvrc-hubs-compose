# ── Deployment Configuration ──
# Uncomment and edit the variables below for your scenario.
# Docker Compose reads this file automatically when saved as ".env".

# ── Scenario: Local (default) ──
# No changes needed. Uses hubs.local with mkcert certificates.

# ── Scenario: LAN ──
# Set HUBS_HOST to your machine's LAN IP (e.g., 192.168.1.100).
# HUBS_HOST=192.168.1.100

# ── Scenario: Remote Server ──
# Set HUBS_HOST to your domain and PRIVATE_NETWORK_IP to your server's public IP.
# HUBS_HOST=hubs.example.com
# PRIVATE_NETWORK_IP=xxx.xxx.xxx.xxx
